{
  "title": "Docker Health Guardian Overview",
  "uid": "guardian-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Monitored Containers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "guardian_monitored_containers", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Open Incidents",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "guardian_open_incidents", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Containers by State",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "guardian_containers_by_state", "legendFormat": "{{state}}", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Incidents by Severity",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "guardian_incidents_by_severity", "legendFormat": "{{severity}}", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Remediation Attempts by Outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(guardian_remediation_attempts_total[5m])",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Recovery Verification Results",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(guardian_recovery_verifications_total[5m])",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Monitoring Cycle Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(guardian_cycle_duration_seconds_bucket[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Collection Errors & Notification Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(guardian_collection_errors_total[5m])", "legendFormat": "collection errors", "refId": "A" },
        { "expr": "rate(guardian_notification_failures_total[5m])", "legendFormat": "notification failures ({{channel}})", "refId": "B" }
      ]
    }
  ]
}
